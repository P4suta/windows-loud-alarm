<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Strict build: every warning (analyzers included) is an error. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors />
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Reproducible restore. `just restore` runs locked; after a version bump in
         Directory.Packages.props, re-evaluate with a force-evaluate restore. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- .NET 8+ artifacts layout: bin/obj/publish under one repo-root artifacts/ tree. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>

    <!-- Declare Windows RIDs on every project so `just publish` (-r win-x64) doesn't
         mutate library lock files and break the next locked restore (NU1004). -->
    <RuntimeIdentifiers Condition="'$(IsTestProject)' != 'true' And '$(RuntimeIdentifiers)' == ''">win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Let non-Windows CI (Automatic Dependency Submission) restore the Windows TFM. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Company>livec</Company>
    <Product>Alarm</Product>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Single source of the app version; release-please rewrites the annotated line.
         AssemblyVersion/FileVersion/InformationalVersion derive from it. -->
    <Version>0.2.0</Version> <!-- x-release-please-version -->
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <UseSharedCompilation>true</UseSharedCompilation>
    <GenerateDocumentationFile Condition="'$(Configuration)' == 'Release'">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn> <!-- we only doc the non-obvious -->
    <ReportAnalyzer Condition="'$(Configuration)' == 'Debug'">true</ReportAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />
  </ItemGroup>
</Project>
